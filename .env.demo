# DEMO / DEV ONLY (committed on purpose). Used by docker compose automatically. Never use these values on a hosted server.
# For your own settings create .env (gitignored); it overrides these.
# Admin password for /admin (POC-only auth).
ADMIN_PASSWORD=change-me-admin
# Secret used to sign admin session tokens (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string
# Per-court scorekeeper PINs: courtSlug:PIN, comma separated. One gym floor: Full, or West + East.
COURT_PINS=full:1111,west:2222,east:3333
# Postgres (docker compose provides this; on a managed host paste the provider URL).
POSTGRES_PASSWORD=scoreboard-dev
DATABASE_URL=postgres://scoreboard:scoreboard-dev@db:5432/scoreboard
# demo = seed the laptop demo (today, America/Chicago) when no game is scheduled for today. true = classic dev seed if empty.
SEED=demo
PORT=3000
# League name shown on the TV header.
LEAGUE_NAME=Lenexa Baptist Church Youth Basketball
# Church branding on the TV/overlay header. CHURCH_LOGO_URL is optional (http(s) URL or a /path in public/); empty = name only.
CHURCH_NAME=Lenexa Baptist Church
CHURCH_LOGO_URL=
# League time zone (CSV import/export times, "up next" ticker). Kansas City area.
TZ=America/Chicago
# Default game length in minutes, used for the shared-floor overlap rule (start + length).
GAME_MINUTES=60
