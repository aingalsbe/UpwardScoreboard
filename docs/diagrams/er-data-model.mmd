erDiagram
  TEAMS ||--o{ GAMES : "home team"
  TEAMS ||--o{ GAMES : "away team"
  COURTS ||--o{ GAMES : "hosts"
  COURTS |o--o| GAMES : "current game"
  GAMES ||--o{ GAME_EVENTS : "logs"
  COURTS }o--o{ COURTS : "conflicts_with"
  TEAMS {
    int id PK
    text name "UK with grade (case-insensitive)"
    text grade "e.g. 5th Grade"
    int grade_order
    text short_name
    text primary_color "unused (season colors)"
    text secondary_color "unused (season colors)"
    text logo_url
    bytea logo_data
    text logo_mime
  }
  COURTS {
    int id PK
    text slug UK
    text name
    text location
    text_array conflicts_with "courts sharing the floor"
    int qr_version "weekly QR token version"
    int current_game_id FK
  }
  GAMES {
    int id PK
    int court_id FK
    int home_team_id FK
    int away_team_id FK
    timestamptz scheduled_at
    text division
    text status "scheduled, active, complete"
    int duration_min "null = GAME_MINUTES"
    bool swap_colors
    text home_cheer
    text home_cheer_logo_url
    bytea home_cheer_logo_data
    text home_cheer_logo_mime
    text away_cheer
    text away_cheer_logo_url
    bytea away_cheer_logo_data
    text away_cheer_logo_mime
    jsonb theme
    jsonb rules
    jsonb history
    int final_home
    int final_away
  }
  GAME_EVENTS {
    bigint id PK
    int game_id FK
    int seq
    text client_cmd_id
    text actor
    jsonb command
    timestamptz created_at
  }
  SETTINGS {
    text key PK "season_name, season_dark, season_light"
    text value
  }
